---
import { Image } from 'astro:assets';
import profile from '../assets/profile.jpg';
import { href, useTranslations } from '../i18n/ui';

const t = useTranslations();
---

<header class="pt-14 pb-12 sm:pt-20 sm:pb-16">
	<a href={href()} class="group flex items-center gap-4 sm:gap-6" data-animate>
		<Image
			src={profile}
			alt={t('site.profileAlt')}
			width={192}
			height={192}
			loading="eager"
			class="size-16 shrink-0 rounded-full object-cover ring-2 ring-border transition duration-300 group-hover:ring-accent-strong sm:size-24"
			transition:name="profile"
		/>
		<div>
			<h1
				class="text-4xl leading-none font-extrabold tracking-tight uppercase sm:text-7xl"
				transition:name="site-title"
			>
				{t('site.title')}
			</h1>
			<p class="mt-2 text-lg text-muted transition-colors group-hover:text-accent-strong sm:mt-3 sm:text-xl">
				{t('site.byline')}
			</p>
		</div>
	</a>
</header>
